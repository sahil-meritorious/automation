# Copy this file to .env and fill in your keys:
#   Linux:   cp .env.example .env
#   Windows: copy .env.example .env
# Never commit .env — it is listed in .gitignore.

# ---------- Transcription (required) — https://console.groq.com/keys
GROQ_API_KEY=
# optional extra Groq keys: when one is rate-limited the app switches to the next immediately
# (keys from the same Groq organisation share limits, so use keys from different organisations)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# or whisper-large-v3
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# e.g. en ; blank = auto-detect
TRANSCRIPTION_LANGUAGE=
# spelling hints, e.g. GTA, Los Santos, Vice City
TRANSCRIPTION_PROMPT=

# ---------- Highlight detection LLM (choose one provider)
# gemini | openai | groq | openrouter | ollama | custom
LLM_PROVIDER=groq
# blank = provider default (groq: openai/gpt-oss-120b)
LLM_MODEL=openai/gpt-oss-120b
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# only for custom / self-hosted endpoints
LLM_BASE_URL=
# only for custom (overrides provider keys if set)
LLM_API_KEY=

# ---------- What the videos are about (helps the AI judge moments)
CONTENT_CONTEXT=GTA gameplay with live commentary
# who the Shorts are for — every AI prompt optimises virality for this audience
TARGET_AUDIENCE=Gaming fans on YouTube Shorts, mostly 16-30, who follow GTA 6 / GTA 5 / Rockstar news, easter eggs, funny moments and streamer reactions

# ---------- Shorts selection
NUM_SHORTS=10
MIN_CLIP_DURATION=15
MAX_CLIP_DURATION=60
PREFERRED_MIN_DURATION=25
PREFERRED_MAX_DURATION=45
MIN_SCORE=60
LLM_RERANK=true

# ---------- Video output
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
# auto (AI decides per Short) | blur_fit | center_crop | offset_crop | face_track
LAYOUT=auto
CROP_X_POSITION=0.5
FOREGROUND_ZOOM=1.0
# auto (AI decides) | dynamic | minimal | karaoke
CAPTION_STYLE=auto
CAPTION_FONT=Arial Black
TITLE_OVERLAY=true
# auto | on | off — "auto" lets the AI decide per Short
PUNCH_IN_MODE=auto
ZOOM_MODE=auto
# on-screen text: auto (AI hook line) | title | off
OVERLAY_TEXT=auto
FADE_TRANSITIONS=true
NORMALIZE_AUDIO=true
# file or folder of music YOU have rights to use
BACKGROUND_MUSIC=
MUSIC_VOLUME=0.08

# ---------- Groq free-tier protection (raise these on a paid tier)
GROQ_MAX_UPLOAD_MB=25
AUDIO_CHUNK_SECONDS=600
AUDIO_CHUNK_OVERLAP=5
GROQ_REQUESTS_PER_MINUTE=18
GROQ_AUDIO_SECONDS_PER_HOUR=7000
GROQ_AUDIO_SECONDS_PER_DAY=28000
TRANSCRIPTION_WORKERS=1

# ---------- YouTube (optional) — see README section "YouTube upload"
# API key: trending-keyword research (read-only)
YOUTUBE_API_KEY=
# OAuth client (type "Desktop app") — required for uploading
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# alternative to the two lines above: path to the downloaded client_secret_*.json
YOUTUBE_CLIENT_SECRETS_FILE=
# Streamlit sign-in returns here; register it EXACTLY as an Authorized redirect URI
YOUTUBE_REDIRECT_URI=http://localhost:8501/
# private | unlisted | public
YOUTUBE_PRIVACY=private
# 20 Gaming, 24 Entertainment, 22 People & Blogs, 23 Comedy
YOUTUBE_CATEGORY_ID=20
YOUTUBE_REGION=US
YOUTUBE_LANGUAGE=en
YOUTUBE_UPLOAD_CAPTIONS=true
# public uploads: publish one Short every N hours (0 = immediately)
YOUTUBE_SCHEDULE_INTERVAL_HOURS=0
# appended to every description, e.g. credit or channel links
YOUTUBE_DESCRIPTION_FOOTER=
# upload automatically when a job finishes
AUTO_UPLOAD=false
TREND_RESEARCH=true
# topic for trend research; blank = derived from the video title
TREND_QUERY=

# ---------- Topic mode: where the AI may look for source videos
#   any_public       = testing: any public video; uploads from these jobs are forced PRIVATE
#   allowed_channels = only the channels listed in ALLOWED_CHANNEL_IDS
#   creative_commons = CC BY videos (credit added automatically)
#   my_channel       = your connected channel
TOPIC_SOURCE=creative_commons
# channels you have permission to clip: channel IDs (UC...) or @handles, comma-separated
# e.g. ALLOWED_CHANNEL_IDS=UCxxxxxxxxxxxxxxxxxxxxxx,@SomeCreator
ALLOWED_CHANNEL_IDS=
TOPIC_MIN_MINUTES=4
TOPIC_MAX_MINUTES=120

# ---------- Performance / reliability
LLM_MAX_CONCURRENCY=2
# token pacing per minute (0 = auto: Groq free tier 7000, -1 = off)
LLM_TOKENS_PER_MINUTE=0
# prompts larger than this are split automatically (0 = auto: Groq 5500, -1 = off)
LLM_MAX_REQUEST_TOKENS=0
RENDER_WORKERS=2
# faster: veryfast ; smaller files: slow
VIDEO_PRESET=medium
VIDEO_CRF=20
KEEP_INTERMEDIATE=false
MIN_FREE_DISK_GB=2
# only if ffmpeg is not on PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
